                                                                <div class="label">Regione</div>
                                                                <textbox width="150px" value="@bind(vm.destinazioneBaseToSave.regione)" ca:autocomplete="off"/>
                                                            </div>
                                                            <div class="field">
                                                                <div class="label">Provincia</div>
                                                                <textbox width="150px" value="@bind(vm.destinazioneBaseToSave.provincia)" ca:autocomplete="off"/>
                                                            </div>
                                                            <div class="field">
                                                                <div class="label">Comune</div>
                                                                <textbox width="150px" value="@bind(vm.destinazioneBaseToSave.comune)" ca:autocomplete="off"/>
                                                            </div>
                                                            <div class="field">
                                                                <div class="label">Frazione</div>
                                                                <textbox width="150px" value="@bind(vm.destinazioneBaseToSave.frazione)" ca:autocomplete="off"/>
                                                            </div>
                                                        </div>
                                                        <div style="display: flex; align-items: center; gap: 1rem; width: 100%">
                                                            <div class="field">
                                                                <div class="label">Indirizzo</div>
                                                                <textbox style="width: 407px" value="@bind(vm.destinazioneBaseToSave.indirizzo)" ca:autocomplete="off"/>
                                                            </div>
                                                            <div class="field">
                                                                <div class="label">CAP</div>
                                                                <textbox width="150px" value="@bind(vm.destinazioneBaseToSave.cap)" ca:autocomplete="off"/>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </tabpanel>
