                                                <div class="custom-fieldset">
                                                    <div class="legend">
                                                        <h:h2>Destinazione Base</h:h2>
                                                        <div class="line"/>
                                                    </div>
                                                    <div style="display: flex; flex-direction: column; align-items: center; gap: 1rem;">
                                                        <div style="display: flex; gap: 1rem; width: 100%">
