<zk xmlns="http://www.zkoss.org/2005/zul" xmlns:h="http://www.w3.org/1999/xhtml"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:w="http://www.zkoss.org/2005/zk/client"
    xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.zkoss.org/2005/zul/zul.xsd">

    <window class="GRIGLIA_INDEX" title="Griglia" height="100%"
            apply="org.zkoss.bind.BindComposer"
            viewModel="@id('vm') @init('com.powerservice.managermag.griglia.GrigliaViewModel')">

        <h:iframe id="gridManager" src="/angular/grid-manager/browser/index.html" style="width: 100%; height: 100%"/>
    </window>
</zk>
